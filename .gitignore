# 输出文件 - 这些是生成的文件，不应推送
output/

# 本地数据文件 - 包含敏感信息或临时数据
data/

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo

# 操作系统文件
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript编译输出
*.js
*.js.map
*.d.ts

# 构建输出
dist/
build/
coverage/

# 环境变量文件（包含API密钥等敏感信息）
.env
.env.local
.env.*.local
config/settings.yaml